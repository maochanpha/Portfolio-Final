{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/product/(.*)",
      "dest": "/public/product/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}